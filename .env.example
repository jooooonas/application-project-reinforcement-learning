# Copy this file to .env and adjust paths for your machine or cluster.
# .env is ignored by git. Paths need not contain `~` is
# not expanded.

# Shared runtime outputs, asset cache, model cache fallback, and fleet state.
# SCRATCH=/absolute/path/to/scratch

# Convenience variable for this file's examples only. Python helpers use the
# resolved settings below, not PROJECT_ROOT itself.
# PROJECT_ROOT=/absolute/path/to/workspace

# Optional VM image override. The default is
# <repo>/../osworld_deployment/Ubuntu.qcow2.
# OSWORLD_QCOW_PATH=/absolute/path/to/Ubuntu.qcow2

# Optional shared model cache. If unset, launch scripts use
# ${SCRATCH}/huggingface.
# HF_HOME=${SCRATCH}/huggingface

# Optional shared fleet layout and generated PrimeRL paths.
# OSWORLD_RUN_BASE=${SCRATCH}/osworld_rl
# OSWORLD_PRIME_RL_CONFIG_PATH=${SCRATCH}/osworld_rl/prime_rl_fleet.toml
# OSWORLD_PRIME_RL_OUTPUT_DIR=${SCRATCH}/osworld_rl/prime_rl

# The OSWorld fleet launcher's outer Slurm stdout/stderr log defaults to
# ${SCRATCH}/logs/slurm-%x.%j.out. These standard Slurm variables override it.
# SBATCH_OUTPUT=${SCRATCH}/logs/slurm-%x.%j.out
# SBATCH_ERROR=${SCRATCH}/logs/slurm-%x.%j.out

# Optional OSWorld task and rollout settings.
# OSWORLD_ARTIFACT_DIR=${SCRATCH}/osworld_rl/artifacts
# OSWORLD_MAX_TASKS=0
# OSWORLD_TASK_SHUFFLE_SEED=0
# OSWORLD_SCREEN_WIDTH=1920
# OSWORLD_SCREEN_HEIGHT=1080
# OSWORLD_DESKTOP_POOL_MIN_READY_SESSIONS=1

# Optional node-local QEMU runtime overrides for env-fleet Slurm jobs. The
# Slurm scripts normally create job-scoped paths below
# ${TMPDIR:?TMPDIR must be set by Slurm}/osworld-${SLURM_JOB_ID}.
# OSWORLD_DESKTOP_POOL_RUNTIME_DIR=${TMPDIR}/osworld-runtime
# OSWORLD_DESKTOP_POOL_LOG_RUNTIME_DIR=${TMPDIR}/osworld-log

# Optional cluster-specific setup sourced by repo-owned OSWorld sbatch jobs.
# CLUSTER_SETUP_SCRIPT=/path/to/cluster_setup.sh
# HAICORE example:
# CLUSTER_SETUP_SCRIPT=${PROJECT_ROOT}/application-project-reinforcement-learning/sbatch/clusters/haicore.sh
# JUWELS example:
# CLUSTER_SETUP_SCRIPT=${PROJECT_ROOT}/application-project-reinforcement-learning/sbatch/clusters/juwels.sh
# JUTIL_PROJECT=<your-jutil-project>

# PrimeRL launch defaults. Explicit CLI values take precedence. Per-node CPU
# and memory requests live in the Slurm template selected by each PrimeRL TOML:
# multi-node requests 32 CPUs/256G, while single-node requests 16 CPUs/128G.
# PRIME_RL_SLURM_PARTITION=<gpu-partition>
# PRIME_RL_SLURM_ACCOUNT=<your-gpu-account>
PRIME_RL_SLURM_TIME=24:00:00
PRIME_RL_GPUS_PER_NODE=2
# PRIME_RL_SLURM_CPUS_PER_TASK=32
# PRIME_RL_SLURM_MEM_PER_NODE=256G
# Only change for multi-node training.
# PRIME_RL_NUM_TRAIN_NODES=1
# PRIME_RL_NUM_INFER_NODES=1

# Standalone CPU fleet defaults. Submit flags take precedence.
# OSWORLD_FLEET_SLURM_PARTITION=<cpu-partition>
OSWORLD_FLEET_SLURM_TIME=24:00:00
OSWORLD_FLEET_SLURM_NODES=1
OSWORLD_FLEET_SLURM_CPUS_PER_TASK=48
OSWORLD_FLEET_SLURM_MEM_PER_NODE=256G
